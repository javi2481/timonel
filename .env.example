# Opcional: copiar a .env. Los defaults de docker-compose.yml funcionan sin este archivo.
#
# Producto (default): TODAS las capas SPA PaddleX + adapter + bridge.
#   .\scripts\full_up.ps1
#   # o: docker compose up -d --build --wait
#
# Compose fuerza ENABLE_*=true en adapter/bridge aunque este archivo diga false.
# Usá este .env para puertos, prompts, umbrales, Face ID, etc.
#
# GPU vehicles:
#   docker compose -f docker-compose.yml -f compose.gpu.yml up --build
#
# On-demand (avanzado, idle stop):
#   docker compose -f docker-compose.yml -f compose.ondemand.yml up -d

# --- Capability flags (producto = true; Compose las fuerza en adapter/bridge) ---
ENABLE_VEHICLES=true
ENABLE_FACE_DETECTION=true
ENABLE_POSE=true
ENABLE_SCENE_OCR=true
ENABLE_PLATE_OCR=true
ENABLE_PEDESTRIAN_ATTRS=true
ENABLE_SCENE_SEG=true
ENABLE_SIGNS=true
ENABLE_OPEN_VOCAB=true
ENABLE_FACE_ID=true
ENABLE_SCENE_CLS=true
ENABLE_INSTANCE_SEG=true
ENABLE_SMALL_OBJECTS=true
ENABLE_ANOMALY=true
ENABLE_CONTAINER_LIFECYCLE=false

# --- Puertos publicados en el host ---
ADAPTER_PORT=8000
PADDLEX_PORT=8080
JETLINKS_PORT=8848
RULES_SINK_PORT=8850
PADDLEX_OCR_PORT=8081
PADDLEX_OBJECTS_PORT=8082
PADDLEX_FACES_PORT=8083
PADDLEX_PEDESTRIANS_PORT=8084
PADDLEX_SCENE_PORT=8085
PADDLEX_POSE_PORT=8086
PADDLEX_FACE_ID_PORT=8087
PADDLEX_SIGNS_PORT=8088

# --- URLs internas (red timonel-network) ---
ADAPTER_INGEST_URL=http://adapter:8000/ingest
ADAPTER_MEDIA_CURRENT_URL=http://adapter:8000/media/current
ADAPTER_PREVIEW_FRAME_URL=http://adapter:8000/preview/frame
ADAPTER_CAPABILITIES_URL=http://adapter:8000/capabilities
PADDLEX_URL=http://paddlex:8080
PADDLEX_PREDICT_PATH=/vehicle-attribute-recognition
PADDLEX_OCR_URL=http://paddlex-ocr:8081
PADDLEX_OBJECTS_URL=http://paddlex-objects:8082
PADDLEX_OBJECTS_PREDICT_PATH=/object-detection
PADDLEX_FACES_URL=http://paddlex-faces:8083
PADDLEX_FACES_PREDICT_PATH=/object-detection
PADDLEX_PEDESTRIANS_URL=http://paddlex-pedestrians:8084
PADDLEX_SCENE_URL=http://paddlex-scene:8085
PADDLEX_POSE_URL=http://paddlex-pose:8086
PADDLEX_FACE_ID_URL=http://paddlex-face-id:8087
PADDLEX_SIGNS_URL=http://paddlex-signs:8088
PADDLEX_SIGNS_OV_URL=http://paddlex-open-vocab:8093
PADDLEX_SCENE_CLS_URL=http://paddlex-scene-cls:8089
PADDLEX_INSTANCES_URL=http://paddlex-instances:8090
PADDLEX_SMALL_OBJECTS_URL=http://paddlex-small-objects:8091
PADDLEX_ANOMALY_URL=http://paddlex-anomaly:8092
PADDLEX_OPEN_VOCAB_URL=http://paddlex-open-vocab:8093

# --- Adaptador ---
TRACK_TTL_SECONDS=10
MAX_DETECTIONS_PER_TRACK=60
EVENTS_BUFFER_SIZE=500
CORS_ORIGINS=*
LOG_LEVEL=INFO
TIMONEL_ENV=development
JETLINKS_WEBHOOK_URL=
JETLINKS_API_KEY=demo
RULES_SINK_API_KEY=demo
RULES_SINK_MAX_ALERTS=100
RULES_SINK_URL=http://rules-sink:8850

# --- Media / bridge ---
MEDIA_DIR=/media
MEDIA_POLL_INTERVAL=1.0
MEDIA_WATCH_INTERVAL=1.0
BRIDGE_FPS=1
JPEG_QUALITY=70
BRIDGE_MAX_WIDTH=1920
ENABLE_INFER_TILING=false
INFER_SLICE_WH=640
INFER_OVERLAP_WH=100
INFER_TILE_THREAD_WORKERS=1
CROSS_CAP_NMS_THRESHOLD=0.5
ENABLE_EVIDENCE_CASCADE=true
CASCADE_OBJECT_LOW_SCORE=0.35
CONTAINER_IDLE_PAUSE_S=120
TIMONEL_ZONES_JSON=
DEMO_MODE=0
HTTP_TIMEOUT=30
PREVIEW_MJPEG_INTERVAL=0.05
PREVIEW_IMAGE_HEARTBEAT_SECONDS=5.0

# --- OCR ---
OCR_MIN_SCORE=0.7
OCR_EVERY_N_FRAMES=5
OCR_TOPK=3
OCR_HTTP_TIMEOUT=5
SCENE_OCR_MIN_SCORE=0.5
SCENE_OCR_MAX_LINES=20

# --- Scene / signs / OV / Face ID ---
SCENE_LABEL_MODE=cityscapes
SCENE_PIPELINE_CONFIG=semantic_segmentation
CROSSWALK_MIN_RATIO=0.01
SIGNS_BACKEND=ov
SIGNS_OV_PROMPT=traffic sign,stop sign,traffic light
SIGNS_OV_THRESHOLD=0.05
SIGNS_THRESHOLD=0.1
OPEN_VOCAB_PROMPT=person,car
OPEN_VOCAB_THRESHOLD=0.05
# Filtro score vehicles (bridge). Subí si hay FP fuera de calle.
VEHICLES_MIN_SCORE=0.55
IDENTITY_HASH_SALT=cambia-este-salt-en-produccion
# Sin key: Identidad no aparece en el panel (available=false).
# Flujo: scripts/face_id_index_build.py → pegá indexKey → recreá adapter+bridge.
FACE_ID_INDEX_KEY=

OCR_PIPELINE_CONFIG=/opt/paddlex/pipelines/ocr_v5_mobile.yaml
PADDLE_BASE_IMAGE=paddlepaddle/paddle:3.0.0
PADDLE_GPU_BASE_IMAGE=paddlepaddle/paddle:3.0.0-gpu-cuda11.8-cudnn8.9-trt8.6
TIMONEL_USE_HPIP=0
