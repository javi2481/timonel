# DEPRECATED — el stack default ya incluye todas las capas SPA.
# Usá .env.example (o ningún .env; Compose trae defaults).
#
# Antes este archivo era para `docker compose --profile full`. Ese profile
# ya no existe para las capas PaddleX: `docker compose up` / scripts/full_up
# levantan el producto completo.
#
# Este archivo se mantiene solo por bookmarks/CI antiguos; es un alias
# documental de .env.example (mismos ENABLE_*=true).

# --- Capability flags (producto) ---
ENABLE_VEHICLES=true
ENABLE_FACE_DETECTION=true
ENABLE_POSE=true
ENABLE_SCENE_OCR=true
ENABLE_PLATE_OCR=true
ENABLE_PEDESTRIAN_ATTRS=true
ENABLE_SCENE_SEG=true
ENABLE_SIGNS=true
ENABLE_OPEN_VOCAB=true
ENABLE_FACE_ID=true
ENABLE_SCENE_CLS=true
ENABLE_INSTANCE_SEG=true
ENABLE_SMALL_OBJECTS=true
ENABLE_ANOMALY=true
ENABLE_CONTAINER_LIFECYCLE=false

# Ver el resto de knobs en .env.example
